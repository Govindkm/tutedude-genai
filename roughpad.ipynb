   "source": [
    "def show_items(*items):\n",
    "    print(\"items =\", items)\n",
    "    print(\"type  =\", type(items))\n",
    "    for item in items:\n",
    "        print(f\"item   = {item} (type={type(item)})\")\n",
    "\n",
    "show_items(\"pen\", \"book\", \"eraser\")\n",
    "show_items(10, 20)"
   ]
  }
